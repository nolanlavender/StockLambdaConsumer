# AWS Configuration
AWS_REGION=us-east-1
KINESIS_STREAM_NAME=stock-prices-stream
DYNAMODB_TABLE_NAME=stock-analytics

# Application Configuration
ENFORCE_MARKET_HOURS=true
TEST_MODE=false
DATA_RETENTION_DAYS=7

# Analytics Configuration
TIME_WINDOWS_MINUTES=1,5,15,30,60,120
MOVING_AVERAGE_WINDOWS_MINUTES=5,15,30,60

# Shutdown Configuration
NO_DATA_TIMEOUT_MINUTES=10
CHECK_INTERVAL_MINUTES=5

# Batch Write Configuration
BATCH_WRITE_INTERVAL_MINUTES=15
BATCH_MAX_SIZE=500
